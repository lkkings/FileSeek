{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileSeek",
  "version": "1.0.3",
  "identifier": "com.fileseek.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "desktop",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/fileseek-mcp-service"
    ],
    "resources": {
      "resources/backend/": "backend/"
    },
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "PlugIns/FileSeekFinderSync.appex": "PlugIns/FileSeekFinderSync.appex"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
